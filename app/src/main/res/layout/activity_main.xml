<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:gravity="center">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SmartCampus Automation"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="30dp"/>

    <!-- ZONE 1: CLASSROOM -->
    <Button
        android:id="@+id/btnSetClassroom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Activate Classroom (Silent Mode)"
        android:onClick="onSetClassroom"
        android:layout_marginBottom="10dp"/>

    <!-- ZONE 2: DORMITORY -->
    <Button
        android:id="@+id/btnSetDorm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Activate Dormitory (Welcome Sound)"
        android:onClick="onSetDorm"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Status: Waiting for User"
        android:id="@+id/tvStatus"
        android:layout_marginTop="20dp"/>

</LinearLayout>